{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tbshethong",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "web/.next"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tbs_db",
      "database_id": "tbs_db_id"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES_BUCKET",
      "bucket_name": "tbs-files"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_APP_URL": "https://tbshethong.workers.dev",
    "JWT_SECRET": "tbs_group_secure_jwt_secret_key_2026"
  }
}
